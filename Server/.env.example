# Used by docker compose and local Spring Boot backend (export before ./gradlew bootRun).
POSTGRES_DB=environment_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5435

DB_URL=jdbc:postgresql://localhost:5435/environment_monitoring
DB_USERNAME=postgres
DB_PASSWORD=postgres

API_PORT=8080

# Base64-encoded JWT secret (at least 256 bits).
JWT_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
JWT_EXPIRATION_MINUTES=60

# Allowed CORS origins for frontend requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082,http://localhost:3000

# Optional MQTT configuration
MQTT_PORT=1883
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=ems-backend
MQTT_USERNAME=ems-backend
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=home/sensor/data
MQTT_DEVICE_COMMAND_TOPIC=home/led/control
MQTT_DEVICE_STATUS_TOPIC=home/led/status

# Object storage (MinIO) for profile avatars
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=ems-minio
MINIO_ROOT_PASSWORD=ems-minio-secret
MINIO_BUCKET=ems-avatars
# Internal address used by the backend container.
MINIO_ENDPOINT=http://minio:9000
# Address the browser uses to load the avatar images.
MINIO_PUBLIC_URL=http://localhost:9010/ems-avatars
